# Repository touch marker.
# Supabase Project Settings > API Keys. This key is safe to expose to the browser.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Allow http://127.0.0.1:3005/** and your deployed origin in Supabase Auth URL configuration.
# Enable the Google provider in Supabase Auth and configure its Google OAuth credentials.

# Optional server-side learning workflow. Use n8n's published production webhook URL.
N8N_INBOUND_WEBHOOK_URL=
# Public webhook: no header authentication required. Never use a VITE_ prefix.
